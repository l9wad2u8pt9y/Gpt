name: "Lotus Cloud · 自动更新节点策略"
desc: |-
  公开URL安全版：不包含机场订阅地址、不包含节点账号/密码。
  直接套在机场原始订阅配置上；机场自身更新后，本覆写自动读取最新 proxies。
  地区聚合与家宽聚合使用 include-all + filter 动态筛选。
  家宽排除香港；无非港家宽时，AI 自动转到“AI · 非港最快”。


geodata-mode: true

geox-url: #!replace
  geoip: https://geo.yuetong.app/geox/geoip.dat
  geosite: https://geo.yuetong.app/geox/geosite.dat
  mmdb: https://geo.yuetong.app/geox/country.mmdb
  asn: https://geo.yuetong.app/geox/GeoLite2-ASN.mmdb

geo-auto-update: false

geo-update-interval: 24

mixed-port: 7890

allow-lan: false

ipv6: true

log-level: info

tcp-concurrent: true

unified-delay: true

keep-alive-interval: 60

keep-alive-idle: 300

profile: #!replace
  store-selected: true
  store-fake-ip: true

dns: #!replace
  enable: true
  cache-algorithm: arc
  listen: :1053
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter-mode: blacklist
  prefer-h3: false
  respect-rules: true
  use-hosts: true
  use-system-hosts: true
  ipv6: true
  fake-ip-filter:
  - '*.lan'
  - '*.local'
  - '*.arpa'
  - localhost
  - localhost.localdomain
  - router.asus.com
  - routerlogin.net
  - captive.apple.com
  - +.push.apple.com
  - +.icloud.com
  - +.apple.com
  - msftconnecttest.com
  - www.msftconnecttest.com
  - +.msftncsi.com
  - connectivitycheck.gstatic.com
  - connectivitycheck.android.com
  - clients3.google.com
  - clients4.google.com
  - android.clients.google.com
  - time.*
  - ntp.*
  - +.market.xiaomi.com
  - localhost.ptlogin2.qq.com
  - Mijia Cloud
  - +._dns-sd._udp.*
  - +._services._dns-sd._udp.*
  default-nameserver:
  - 223.5.5.5
  - 119.29.29.29
  nameserver:
  - https://doh.pub/dns-query
  - https://dns.alidns.com/dns-query
  - https://223.5.5.5/dns-query
  - https://120.53.53.53/dns-query
  nameserver-policy:
    +.apple.com: https://dns.alidns.com/dns-query
    +.icloud.com: https://dns.alidns.com/dns-query
    +.icloud.com.cn: https://dns.alidns.com/dns-query
    +.icloud-content.com.cn: https://dns.alidns.com/dns-query
    +.claude.ai: https://1.1.1.1/dns-query
    +.anthropic.com: https://1.1.1.1/dns-query
    +.openai.com: https://1.1.1.1/dns-query
    +.chatgpt.com: https://1.1.1.1/dns-query
    +.cursor.com: https://1.1.1.1/dns-query
    +.cursor.sh: https://1.1.1.1/dns-query
    +.x.ai: https://1.1.1.1/dns-query
    +.grok.com: https://1.1.1.1/dns-query
    +.poe.com: https://1.1.1.1/dns-query
    +.perplexity.ai: https://1.1.1.1/dns-query
    +.huggingface.co: https://1.1.1.1/dns-query
    +.cohere.com: https://1.1.1.1/dns-query
    +.mistral.ai: https://1.1.1.1/dns-query
    +.together.ai: https://1.1.1.1/dns-query
    +.groq.com: https://1.1.1.1/dns-query
    +.fireworks.ai: https://1.1.1.1/dns-query
    +.replicate.com: https://1.1.1.1/dns-query
    +.midjourney.com: https://1.1.1.1/dns-query
    +.stability.ai: https://1.1.1.1/dns-query
    +.runwayml.com: https://1.1.1.1/dns-query
    +.copilot.microsoft.com: https://1.1.1.1/dns-query
    +.codeium.com: https://1.1.1.1/dns-query
    +.windsurf.com: https://1.1.1.1/dns-query
    +.bolt.new: https://1.1.1.1/dns-query
    +.v0.dev: https://1.1.1.1/dns-query
    +.replit.com: https://1.1.1.1/dns-query
    +.replit.dev: https://1.1.1.1/dns-query
    +.vercel.ai: https://1.1.1.1/dns-query
    +.gemini.google.com: https://1.1.1.1/dns-query
    +.bard.google.com: https://1.1.1.1/dns-query
    +.aistudio.google.com: https://1.1.1.1/dns-query
    +.ai.google.dev: https://1.1.1.1/dns-query
    +.generativelanguage.googleapis.com: https://1.1.1.1/dns-query
    +.meta.ai: https://1.1.1.1/dns-query
    +.sora.com: https://1.1.1.1/dns-query

proxy-groups: #!replace
- name: Lotus Cloud
  type: select
  proxies:
  - Lotus · 自动选择
  - Lotus · 故障转移
  - 家宽聚合
  - Lotus · 🇭🇰 香港聚合
  - Lotus · 🇹🇼 台湾聚合
  - Lotus · 🇯🇵 日本聚合
  - Lotus · 🇰🇷 韩国聚合
  - Lotus · 🇸🇬 新加坡聚合
  - Lotus · 🇺🇸 美国聚合
  - Lotus · 🇬🇧 英国聚合
  - Lotus · 🇩🇪 德国聚合
  - Lotus · 🇳🇱 荷兰聚合
  - Lotus · 🇦🇺 澳大利亚聚合
  - Lotus · 🇨🇦 加拿大聚合
  - Lotus · 🌏 更多地区
  - DIRECT
  include-all: true
  exclude-filter: (?i)(剩余|流量|重置|到期|网站|官网|套餐|距离)
- name: YouTube
  type: select
