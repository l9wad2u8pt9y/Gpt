  exclude-filter: (?i)(剩余|流量|重置|到期|网站|官网|套餐|距离)
- name: Lotus · 自动选择
  type: url-test
  include-all: true
  url: http://www.gstatic.com/generate_204
  interval: 600
  tolerance: 50
  lazy: true
  exclude-filter: (?i)(剩余|流量|重置|到期|网站|官网|套餐|距离)
- name: Lotus · 故障转移
  type: fallback
  include-all: true
  exclude-filter: (?i)(剩余|流量|重置|到期|网站|官网|套餐|距离)
  url: http://www.gstatic.com/generate_204
  interval: 600
  lazy: true
- name: 家宽聚合
  type: url-test
  include-all: true
  url: http://www.gstatic.com/generate_204
  interval: 600
  tolerance: 50
  lazy: true
  filter: (?i)(家宽)
  exclude-filter: (?:(?i)(剩余|流量|重置|到期|网站|官网|套餐|距离))|(?:(?i)(香港|🇭🇰|(^|[^A-Za-z])HK([^A-Za-z]|$)))
- name: AI · 非港最快
  type: url-test
  include-all: true
  url: http://www.gstatic.com/generate_204
  interval: 600
  tolerance: 50
  lazy: true
  exclude-filter: (?:(?i)(剩余|流量|重置|到期|网站|官网|套餐|距离))|(?:(?i)(香港|🇭🇰|(^|[^A-Za-z])HK([^A-Za-z]|$)))
- name: Lotus · 🇭🇰 香港聚合
